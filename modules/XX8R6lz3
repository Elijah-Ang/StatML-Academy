    function cStage8(t){cWorld(t,K.red,()=>{cHeader('08','LOSS = A NUMERICAL TEACHER','Error is not a moral judgment. It is a measurable distance the optimizer can use.',K.red);cGlass(56,152,572,330,K.red,.07);cMono('PREDICTION VS TRUTH',84,186,11,K.red,'left',850);const ax=112,aw=462,yy=326;cLine(ax,yy,ax+aw,yy,'rgba(148,163,184,.34)',4);for(let i=0;i<=5;i++){const xx=ax+aw*i/5;cLine(xx,yy-8,xx,yy+8,'rgba(148,163,184,.32)',1);cMono((i/5).toFixed(1),xx,yy+28,10,K.muted,'center')}const pred=ax+aw*.82,truth=ax+aw;cGlow(pred,yy,9,K.indigo);cGlow(truth,yy,9,K.green);cMono('prediction 0.82',pred,yy-36,13,K.indigo,'center',800);cMono('truth 1.00',truth,yy+44,13,K.green,'center',800);cLine(pred,yy+75,truth,yy+75,K.red,3,[5,6]);cMono('gap becomes loss', (pred+truth)/2,yy+105,13,K.red,'center',800);cGlass(678,152,266,330,K.red,.12);cMono('LOSS FUNCTION',811,188,11,K.red,'center',850);cText('small gap',811,250,18,K.muted,'center');cText('↓',811,294,28,K.red,'center',800,'JetBrains Mono');cText('small loss',811,348,26,K.ink,'center',800,'JetBrains Mono');cPill('loss guides updates',706,410,210,K.indigo);cFooter('prediction ↔ truth','loss is optimized · metrics explain')})}

