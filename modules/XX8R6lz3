<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="A scroll-driven StatML Academy lesson that explains neural networks from raw data to deployment through a sequence of visual learning scenes.">
  <title>Neural Networks — Visual Lesson | StatML Academy</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    *,*::before,*::after{box-sizing:border-box}
    :root{
      --statml-page:#f7f7f4;--statml-page-subtle:#f0efeb;--statml-surface:#fff;
      --statml-border:#e7e5e4;--statml-text:#1f2937;--statml-text-secondary:#4b5563;
      --statml-text-muted:#6b7280;--statml-brand:#6366f1;--statml-brand-strong:#4f46e5;
      --statml-brand-soft:#eef2ff;--statml-success:#16a34a;--statml-warning:#d97706;
      --statml-danger:#dc2626;--statml-info:#2563eb;--statml-cyan:#0891b2;
      --statml-radius-control:8px;--statml-radius-card:12px;--statml-radius-visual:16px;
      --statml-shadow-card:0 2px 8px rgba(15,23,42,.045);
      --statml-shadow-visual:0 14px 34px rgba(15,23,42,.07);
      --sans:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
      --mono:"JetBrains Mono",ui-monospace,SFMono-Regular,Consolas,monospace;
    }
    html{scroll-behavior:smooth;scroll-padding-top:68px;background:var(--statml-page)}
    body{margin:0;background:var(--statml-page);color:var(--statml-text);font-family:var(--sans);line-height:1.65;overflow-x:hidden;text-rendering:optimizeLegibility;-webkit-font-smoothing:antialiased}
    body *{box-sizing:border-box}
    ::selection{background:rgba(99,102,241,.18)}
    :focus-visible{outline:3px solid rgba(99,102,241,.35)!important;outline-offset:3px!important}
    a{color:inherit}
    button,input,select{font:inherit}
    .skip-link{position:fixed;z-index:1400;left:1rem;top:-5rem;padding:.65rem .9rem;border:1px solid var(--statml-border);border-radius:8px;background:#fff;color:var(--statml-brand-strong);text-decoration:none;transition:top .2s}
    .skip-link:focus{top:1rem}
    .progress-bar{position:fixed;inset:0 auto auto 0;height:4px;width:0;z-index:1200;background:linear-gradient(90deg,var(--statml-brand),var(--statml-brand-strong));transition:width .12s linear}
    .statml-site-nav{position:fixed;inset:4px 0 auto;height:54px;z-index:1100;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:0 24px;background:rgba(247,247,244,.84);border-bottom:1px solid rgba(231,229,228,.85);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px)}
    .statml-site-nav a{text-decoration:none}
    .statml-brand-link{display:inline-flex;align-items:center;gap:10px;font-size:.84rem;font-weight:700;letter-spacing:-.01em;white-space:nowrap}
    .statml-brand-mark{width:24px;height:24px;display:grid;place-items:center;border:1px solid var(--statml-border);border-radius:7px;background:var(--statml-surface);color:var(--statml-brand-strong);font-family:var(--mono);font-size:.72rem;box-shadow:var(--statml-shadow-card)}
    .statml-nav-topic{min-width:0;color:var(--statml-text-secondary);font-size:.79rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .statml-nav-meta{color:var(--statml-text-muted);font-family:var(--mono);font-size:.68rem;letter-spacing:.04em;white-space:nowrap}
    .statml-hero{min-height:100svh;padding:7.5rem 2rem 5rem;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;position:relative;overflow:hidden;isolation:isolate}
    .statml-hero::after{content:"";position:absolute;inset:0;z-index:-2;background-image:radial-gradient(circle at 50% 42%,rgba(99,102,241,.16),transparent 38%),radial-gradient(rgba(99,102,241,.20) .8px,transparent .8px);background-size:auto,30px 30px;mask-image:linear-gradient(to bottom,rgba(0,0,0,.82),transparent 94%);opacity:.82}
    #heroCanvas{position:absolute;inset:0;width:100%;height:100%;z-index:-1;pointer-events:none;opacity:.94}
    .hero-inner{width:min(100%,980px);position:relative;z-index:2}
    .hero-badge{display:inline-flex;align-items:center;justify-content:center;padding:.42rem .9rem;margin-bottom:1.35rem;border:1px solid rgba(99,102,241,.22);border-radius:999px;background:rgba(238,242,255,.82);color:var(--statml-brand-strong);font-family:var(--mono);font-size:.72rem;font-weight:600;letter-spacing:.09em;text-transform:uppercase}
    .statml-hero h1{max-width:980px;margin:0 auto 1.35rem;font-size:clamp(2.8rem,6.5vw,5rem);font-weight:700;line-height:1.04;letter-spacing:-.045em;background:linear-gradient(135deg,#111827 8%,var(--statml-brand-strong) 100%);-webkit-background-clip:text;background-clip:text;color:transparent;-webkit-text-fill-color:transparent}
    .hero-subtitle{max-width:720px;margin:0 auto;color:var(--statml-text-secondary);font-size:clamp(1.05rem,2vw,1.28rem);line-height:1.55}
    .hero-note{max-width:660px;margin:1rem auto 0;color:var(--statml-text-muted);font-size:.88rem;line-height:1.55}
    .statml-overview{width:min(850px,100%);margin:2rem auto 0;padding:1rem;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.7rem;border:1px solid rgba(231,229,228,.95);border-radius:var(--statml-radius-visual);background:rgba(255,255,255,.66);box-shadow:var(--statml-shadow-card);backdrop-filter:blur(8px)}
    .statml-overview-item{display:flex;align-items:flex-start;gap:.65rem;padding:.65rem .72rem;text-align:left;color:var(--statml-text-secondary);font-size:.83rem;line-height:1.45}
    .statml-overview-number{flex:0 0 auto;display:grid;place-items:center;width:22px;height:22px;border-radius:7px;background:var(--statml-brand-soft);color:var(--statml-brand-strong);font-family:var(--mono);font-size:.68rem;font-weight:700}
    .scroll-cue{margin-top:1.6rem;color:var(--statml-text-muted);font-family:var(--mono);font-size:.7rem;letter-spacing:.08em;text-transform:uppercase;animation:floatCue 2s ease-in-out infinite}
    @keyframes floatCue{50%{transform:translateY(5px);opacity:.65}}
    .statml-layout{display:grid;grid-template-columns:minmax(0,45%) minmax(0,55%);width:100%;max-width:1400px;margin:0 auto;align-items:start}
    .statml-narrative{min-width:0;padding:0 4rem 10vh;z-index:2}
    .statml-stage{min-height:92svh;padding:5rem 0;scroll-margin-top:62px;border-bottom:1px solid rgba(231,229,228,.72)}
    .statml-stage:last-child{border-bottom:none}
    .stage-label{margin:0 0 .9rem;display:flex;align-items:center;gap:.6rem;color:var(--statml-brand);font-family:var(--mono);font-size:.68rem;font-weight:700;letter-spacing:.11em;text-transform:uppercase}
    .stage-label::before{content:"";width:22px;height:1px;background:var(--statml-brand);opacity:.75;flex:0 0 auto}
    .statml-stage h2{margin:0 0 1.25rem;font-size:clamp(1.75rem,3vw,2.15rem);font-weight:700;line-height:1.18;letter-spacing:-.028em}
    .statml-stage h3{margin:0 0 .65rem;color:var(--statml-text);font-size:1.05rem;font-weight:650;letter-spacing:-.012em}
    .statml-stage p,.statml-stage li{color:var(--statml-text-secondary);font-size:1rem;line-height:1.7}
    .statml-stage p{margin:.6rem 0 1rem}
    .statml-stage strong{color:var(--statml-text);font-weight:650}
    .glass-card,.statml-prereq,.statml-deepening,.statml-takeaways,.quiz-card,.control-card,.compare-grid>div{margin:1.25rem 0;padding:1.1rem 1.2rem;border:1px solid var(--statml-border);border-radius:var(--statml-radius-card);background:var(--statml-surface);box-shadow:var(--statml-shadow-card)}
    .glass-card p:last-child,.statml-prereq p:last-child,.statml-deepening p:last-child,.statml-takeaways p:last-child{margin-bottom:0}
    .formula-block{padding:1rem 1.15rem;margin:1rem 0;background:var(--statml-page-subtle);color:var(--statml-text);border:1px solid var(--statml-border);border-left:3px solid var(--statml-brand);border-radius:var(--statml-radius-control);font-family:var(--mono);font-size:.88rem;line-height:1.65;overflow-x:auto;white-space:pre-wrap}
    .insight-box,.warning-note{margin:1.1rem 0;padding:.9rem 1rem;border:1px solid rgba(99,102,241,.18);border-left:4px solid var(--statml-brand);border-radius:0 var(--statml-radius-control) var(--statml-radius-control) 0;background:rgba(238,242,255,.68);color:var(--statml-text-secondary)}
    .warning-note{border-color:rgba(217,119,6,.24);border-left-color:var(--statml-warning);background:rgba(255,251,235,.9);color:#92400e}
    .insight-box p,.warning-note p{margin:0;font-size:.92rem}
    .statml-prereq{border-left:4px solid var(--statml-info)}
    .statml-deepening{border-left:4px solid var(--statml-warning);background:rgba(255,251,235,.66)}
    .statml-takeaways{border-left:4px solid var(--statml-brand);background:rgba(238,242,255,.58)}
    .content-kicker{display:block;margin-bottom:.4rem;color:var(--statml-text-muted);font-family:var(--mono);font-size:.67rem;font-weight:700;letter-spacing:.09em;text-transform:uppercase}
    .tag{display:inline-flex;align-items:center;padding:.2rem .55rem;border-radius:999px;background:var(--statml-brand-soft);color:var(--statml-brand-strong);font-family:var(--mono);font-size:.72rem;font-weight:600}
    .tag.green{background:#ecfdf5;color:#15803d}.tag.amber{background:#fffbeb;color:#b45309}.tag.red{background:#fef2f2;color:#b91c1c}.tag.blue{background:#eff6ff;color:#1d4ed8}
    .metric-row{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.7rem;margin:1rem 0}
    .metric-card{padding:.9rem;border:1px solid var(--statml-border);border-radius:var(--statml-radius-card);background:var(--statml-page);text-align:center}
    .metric-value{font-family:var(--mono);font-size:1.18rem;font-weight:700;color:var(--statml-text)}
    .metric-label{margin-top:.25rem;color:var(--statml-text-muted);font-family:var(--mono);font-size:.65rem;letter-spacing:.06em;text-transform:uppercase}
    .plain-translation{display:grid;grid-template-columns:auto 1fr;gap:.75rem;align-items:start;margin:1.1rem 0;padding:1rem;border:1px dashed #c7d2fe;border-radius:var(--statml-radius-card);background:#fafaff}
    .plain-icon{display:grid;place-items:center;width:30px;height:30px;border-radius:9px;background:var(--statml-brand-soft);color:var(--statml-brand-strong);font-family:var(--mono);font-weight:700}
    .plain-translation p{margin:0;font-size:.92rem}
    .two-col,.compare-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.75rem}
    .choice-learn-panel{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));margin:1.25rem 0;border:1px solid var(--statml-border);border-radius:var(--statml-radius-card);background:var(--statml-surface);box-shadow:var(--statml-shadow-card);overflow:hidden}
    .choice-learn-side{padding:1.1rem 1.2rem}
    .choice-learn-side+ .choice-learn-side{border-left:1px solid var(--statml-border);background:linear-gradient(145deg,#fafaff,var(--statml-brand-soft))}
    .choice-learn-side ul{margin:.65rem 0 0;padding-left:1.15rem}
    .choice-learn-side li{font-size:.9rem;line-height:1.55}
    .case-walkthrough{display:grid;gap:.65rem;margin:1rem 0}
    .case-walkthrough>div{padding:.85rem 1rem;border:1px solid var(--statml-border);border-radius:10px;background:#fff}
    .case-walkthrough p{margin:0;font-size:.9rem}
    .mini-table{width:100%;border-collapse:collapse;margin:1rem 0;font-size:.85rem}
    .mini-table th,.mini-table td{padding:.7rem .75rem;border:1px solid var(--statml-border);text-align:left;vertical-align:top}
    .mini-table th{background:var(--statml-page-subtle);color:var(--statml-text-muted);font-size:.68rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase}
    .mini-table td{color:var(--statml-text-secondary)}
    .mini-table td.mono{font-family:var(--mono);font-size:.78rem}
    .statml-rigor-panel{margin:1.5rem 0;padding:1rem 1.1rem;border:1px solid #c7d2fe;border-radius:14px;background:linear-gradient(145deg,#f8fafc,#eef2ff);color:#1e293b;line-height:1.55}
    .statml-rigor-panel h3{margin:.2rem 0 1rem;font-size:1.18rem;color:#312e81}
    .statml-rigor-kicker{margin:0!important;color:#6366f1!important;font:700 .68rem/1.2 var(--sans)!important;letter-spacing:.12em;text-transform:uppercase}
    .statml-rigor-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.75rem}
    .statml-rigor-grid>div{padding:.8rem;border:1px solid #e2e8f0;border-radius:10px;background:rgba(255,255,255,.8)}
    .statml-rigor-grid h4{margin:0 0 .3rem;color:#3730a3;font-size:.82rem}.statml-rigor-grid p{margin:0;font-size:.88rem;color:#334155}
    details.deep-dive{margin:1.1rem 0;border:1px solid var(--statml-border);border-radius:var(--statml-radius-card);background:rgba(255,255,255,.74);overflow:hidden}
    details.deep-dive summary{padding:.9rem 1rem;cursor:pointer;color:var(--statml-text);font-weight:650;list-style:none}
    details.deep-dive summary::-webkit-details-marker{display:none}
    details.deep-dive summary::after{content:"+";float:right;color:var(--statml-brand);font-family:var(--mono)}
    details.deep-dive[open] summary::after{content:"−"}
    .deep-content{padding:0 1rem 1rem}
    .control-card label{display:block;margin:.7rem 0 .35rem;color:var(--statml-text);font-size:.82rem;font-weight:650}
    input[type=range]{width:100%;accent-color:var(--statml-brand)}
    .control-readout{font-family:var(--mono);color:var(--statml-brand-strong);font-weight:700}
    .button-row{display:flex;gap:.55rem;flex-wrap:wrap;margin-top:.7rem}
    .btn,.quiz-option{min-height:38px;padding:.55rem .8rem;border:1px solid var(--statml-border);border-radius:var(--statml-radius-control);background:#fff;color:var(--statml-text);cursor:pointer;transition:border-color .18s,background .18s,transform .18s}
    .btn:hover,.quiz-option:hover{border-color:rgba(99,102,241,.55);transform:translateY(-1px)}
    .btn.active,.btn.primary{background:var(--statml-brand);border-color:var(--statml-brand);color:#fff}
    .quiz-card{border-left:4px solid var(--statml-brand)}
    .quiz-options{display:grid;gap:.5rem;margin-top:.8rem}
    .quiz-option{text-align:left;width:100%}
    .quiz-option.correct{background:#ecfdf5;border-color:var(--statml-success);color:#15803d;font-weight:650}
    .quiz-option.incorrect{background:#fef2f2;border-color:var(--statml-danger);color:#b91c1c}
    .quiz-feedback{display:none;margin-top:.7rem;padding:.65rem .75rem;border-radius:8px;background:var(--statml-page);font-size:.85rem;font-weight:600}
    .statml-visual{height:100svh;position:sticky;top:0;padding:4.2rem 1.15rem 1.1rem;display:flex;align-items:stretch;background:#090c15;border-left:1px solid #22283a;overflow:hidden;z-index:1}
    .statml-visual::before{content:"";position:absolute;inset:0;pointer-events:none;background:radial-gradient(ellipse at 20% 10%,rgba(99,102,241,.14),transparent 38%),radial-gradient(ellipse at 90% 78%,rgba(8,145,178,.08),transparent 38%);mix-blend-mode:screen}
    .statml-visual-card{flex:1;min-width:0;min-height:0;display:grid;grid-template-rows:auto 1fr auto;overflow:hidden;background:#0b0f1b;border:1px solid rgba(148,163,184,.24);border-radius:20px;box-shadow:0 24px 70px rgba(0,0,0,.32),inset 0 1px 0 rgba(255,255,255,.05);position:relative;z-index:1}
    .visual-topbar{display:flex;justify-content:space-between;gap:1rem;align-items:center;padding:.82rem 1rem;border-bottom:1px solid rgba(148,163,184,.16);background:rgba(11,15,27,.92);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px)}
    .visual-kicker{color:#a5b4fc;font-family:var(--mono);font-size:.65rem;font-weight:700;letter-spacing:.11em;text-transform:uppercase}
    .visual-title{margin-top:.15rem;color:#f8fafc;font-size:.9rem;font-weight:650;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .visual-badge{padding:.28rem .55rem;border:1px solid rgba(129,140,248,.28);border-radius:999px;background:rgba(99,102,241,.12);color:#c7d2fe;font-family:var(--mono);font-size:.62rem;white-space:nowrap;box-shadow:0 0 24px rgba(99,102,241,.12)}
    .canvas-wrap{position:relative;min-height:0;background:#0a0e19;isolation:isolate}
    #mainCanvas{position:absolute;inset:0;display:block;width:100%;height:100%;opacity:1;pointer-events:auto;touch-action:none}
    .scene-svg{position:absolute;inset:0;display:none;width:100%;height:100%;z-index:2;overflow:visible}
    .scene-svg text{font-family:var(--sans);dominant-baseline:middle}
    .scene-svg .mono{font-family:var(--mono)}
    .scene-svg .scene-label{font-family:var(--mono);font-size:13px;font-weight:700;letter-spacing:.12em}
    .scene-svg .scene-note{font-size:15px;fill:var(--statml-text-muted)}
    .scene-svg .scene-title{font-size:22px;font-weight:700;letter-spacing:-.02em}
    .scene-svg .scene-small{font-size:12px;fill:var(--statml-text-muted)}
    .scene-svg .scene-value{font-family:var(--mono);font-size:21px;font-weight:800}
    .scene-svg .scene-line{stroke:#d9dde7;stroke-width:1.5;stroke-linecap:round}
    .scene-svg .scene-path{fill:none;stroke-linecap:round;stroke-linejoin:round}
    .scene-svg .scene-arrow{marker-end:url(#sceneArrow)}
    .scene-svg .scene-pulse{filter:drop-shadow(0 0 7px rgba(99,102,241,.45))}
    .scene-svg .scene-dashed{stroke-dasharray:7 7}
    .scene-svg .scene-muted{opacity:.34}
    .scene-svg .scene-focus{filter:drop-shadow(0 8px 16px rgba(79,70,229,.14))}
    .scene-svg .scene-badge{font-family:var(--mono);font-size:12px;font-weight:700;letter-spacing:.05em}
    .scene-svg .scene-axis{stroke:#cbd5e1;stroke-width:1.4}
    .scene-svg .scene-grid{stroke:rgba(99,102,241,.09);stroke-width:1}
    .scene-svg .scene-serif{font-family:Georgia,serif}
    @media(max-width:620px){.scene-svg .scene-label{font-size:12px}.scene-svg .scene-note{font-size:13px}.scene-svg .scene-title{font-size:20px}.scene-svg .scene-small{font-size:11px}.scene-svg .scene-value{font-size:18px}.scene-svg .scene-badge{font-size:11px}}
    .visual-foot{display:grid;grid-template-columns:1fr auto;gap:.75rem;align-items:center;padding:.65rem .9rem;border-top:1px solid rgba(148,163,184,.16);background:rgba(8,12,22,.94)}
    .visual-foot-text{min-width:0;color:#aab5ca;font-size:.78rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .visual-foot-code{font-family:var(--mono);font-size:.66rem;color:#8b9cfb}
    .statml-stage-rail{position:fixed;right:14px;top:50%;transform:translateY(-50%);z-index:1000;display:flex;flex-direction:column;gap:7px;padding:10px 8px;border:1px solid rgba(231,229,228,.92);border-radius:999px;background:rgba(255,255,255,.78);box-shadow:var(--statml-shadow-card);backdrop-filter:blur(10px)}
    .statml-stage-button{position:relative;width:9px;height:9px;padding:0;border:1px solid #cbd5e1;border-radius:999px;background:#e5e7eb;cursor:pointer;transition:transform .18s,background .18s,box-shadow .18s}
    .statml-stage-button:hover{transform:scale(1.28);background:#a5b4fc}
    .statml-stage-button[aria-current=step]{background:var(--statml-brand);border-color:var(--statml-brand);box-shadow:0 0 0 5px rgba(99,102,241,.12)}
    .statml-stage-button span{position:absolute;right:19px;top:50%;transform:translateY(-50%) translateX(4px);width:max-content;max-width:240px;padding:.4rem .55rem;border-radius:7px;background:var(--statml-text);color:white;font-family:var(--sans);font-size:.7rem;line-height:1.3;opacity:0;pointer-events:none;transition:opacity .15s,transform .15s}
    .statml-stage-button:hover span,.statml-stage-button:focus-visible span{opacity:1;transform:translateY(-50%) translateX(0)}
    @media(max-width:1100px){.statml-narrative{padding-inline:2.5rem}.metric-row{grid-template-columns:1fr}.statml-stage p,.statml-stage li{font-size:.95rem}}
    @media(max-width:900px){
      .statml-site-nav{height:50px;padding:0 14px}.statml-brand-link{font-size:.78rem}.statml-nav-topic{font-size:.72rem}.statml-nav-meta{font-size:.6rem;letter-spacing:.02em}
      .statml-hero{padding:6.5rem 1.2rem 4rem}.statml-overview{grid-template-columns:1fr;gap:.2rem;padding:.55rem}.statml-overview-item{padding:.48rem .55rem}
      .statml-layout{display:flex;flex-direction:column}.statml-visual{order:1;width:100%;height:58svh;min-height:380px;top:0;padding:3.6rem .55rem .55rem;border-left:0;border-bottom:1px solid #22283a;z-index:50}
      .statml-narrative{order:2;width:100%;padding:0 1.35rem 4rem}.statml-stage{min-height:auto;padding:3.4rem 0}.statml-stage-rail{display:none}.visual-foot{display:none}
      .two-col,.compare-grid,.choice-learn-panel{grid-template-columns:1fr}.choice-learn-side+ .choice-learn-side{border-left:0;border-top:1px solid var(--statml-border)}
