    addEventListener('scroll',updateProgress,{passive:true});updateProgress();

    $('#dropoutRate').addEventListener('input',e=>{state.dropout=Number(e.target.value)/100;$('#dropoutReadout').textContent=`${e.target.value}%`;draw()});
    $('#threshold').addEventListener('input',e=>{state.threshold=Number(e.target.value)/100;$('#thresholdReadout').textContent=state.threshold.toFixed(2);updateThresholdReadout();toyCalc();draw()});
    $('#errorThreshold').addEventListener('input',e=>{state.threshold=Number(e.target.value)/100;updateThresholdReadout();toyCalc();draw()});
    $$('[data-task]').forEach(btn=>btn.addEventListener('click',()=>{$$('[data-task]').forEach(b=>{const selected=b.dataset.task===btn.dataset.task;b.classList.toggle('active',selected);b.setAttribute('aria-pressed',String(selected))});state.task=btn.dataset.task;draw()}));
    $$('[data-feature]').forEach(btn=>btn.addEventListener('click',()=>{$$('[data-feature]').forEach(b=>{b.classList.remove('active');b.setAttribute('aria-pressed','false')});btn.classList.add('active');btn.setAttribute('aria-pressed','true');state.selectedFeature=btn.dataset.feature;startTime=performance.now();draw()}));
    $$('[data-relu]').forEach(btn=>btn.addEventListener('click',()=>{$$('[data-relu]').forEach(b=>{b.classList.remove('active');b.setAttribute('aria-pressed','false')});btn.classList.add('active');btn.setAttribute('aria-pressed','true');state.reluEnabled=btn.dataset.relu==='on';draw()}));
    $$('[data-error-sort]').forEach(btn=>btn.addEventListener('click',()=>{$$('[data-error-sort]').forEach(b=>{const selected=b===btn;b.classList.toggle('active',selected);b.setAttribute('aria-pressed',String(selected))});state.errorSort=btn.dataset.errorSort;draw()}));
    $$('[data-lr-mode]').forEach(btn=>btn.addEventListener('click',()=>{$$('[data-lr-mode]').forEach(b=>{const selected=b===btn;b.classList.toggle('active',selected);b.setAttribute('aria-pressed',String(selected))});state.learningMode=btn.dataset.lrMode;state.learningRate=state.learningMode==='tiny'?.02:state.learningMode==='large'?.56:.12;state.weight=.78;state.optimPaused=false;state.optimElapsed=0;startTime=performance.now();$('#optimPause').textContent='Pause';$('#optimPause').setAttribute('aria-pressed','false');draw()}));
    $('#optimPause').addEventListener('click',e=>{state.optimPaused=!state.optimPaused;if(state.optimPaused)state.optimElapsed=performance.now()-startTime;else startTime=performance.now()-state.optimElapsed;e.currentTarget.textContent=state.optimPaused?'Resume':'Pause';e.currentTarget.setAttribute('aria-pressed',String(state.optimPaused));draw()});
    canvas.addEventListener('pointerdown',e=>{if(state.active!==10||!state.curveGeom)return;state.draggingWeight=true;state.optimPaused=true;state.optimElapsed=0;$('#optimPause').textContent='Resume';$('#optimPause').setAttribute('aria-pressed','true');canvas.setPointerCapture?.(e.pointerId);const rect=canvas.getBoundingClientRect(),x=e.clientX-rect.left,g=state.curveGeom,raw=g.min+(x-g.ax)/g.aw*(g.max-g.min);state.weight=Math.max(0,Math.min(1,raw));draw()});
    canvas.addEventListener('pointermove',e=>{if(!state.draggingWeight||!state.curveGeom)return;const rect=canvas.getBoundingClientRect(),x=e.clientX-rect.left,g=state.curveGeom,raw=g.min+(x-g.ax)/g.aw*(g.max-g.min);state.weight=Math.max(0,Math.min(1,raw));draw()});
    canvas.addEventListener('pointerup',e=>{if(!state.draggingWeight)return;state.draggingWeight=false;canvas.releasePointerCapture?.(e.pointerId);draw()});
    canvas.addEventListener('pointercancel',()=>{state.draggingWeight=false});
    sceneSvg.addEventListener('pointerdown',e=>{if(state.active!==10||!state.svgCurveGeom)return;e.preventDefault();state.draggingWeight=true;state.optimPaused=true;state.optimElapsed=0;$('#optimPause').textContent='Resume';$('#optimPause').setAttribute('aria-pressed','true');sceneSvg.setPointerCapture?.(e.pointerId);const r=sceneSvg.getBoundingClientRect(),g=state.svgCurveGeom,x=(e.clientX-r.left)/r.width*1000,raw=g.min+(x-g.ax)/g.aw*(g.max-g.min);state.weight=Math.max(0,Math.min(1,raw));draw()});
    sceneSvg.addEventListener('pointermove',e=>{if(!state.draggingWeight||!state.svgCurveGeom)return;e.preventDefault();const r=sceneSvg.getBoundingClientRect(),g=state.svgCurveGeom,x=(e.clientX-r.left)/r.width*1000,raw=g.min+(x-g.ax)/g.aw*(g.max-g.min);state.weight=Math.max(0,Math.min(1,raw));draw()});
    sceneSvg.addEventListener('pointerup',e=>{if(!state.draggingWeight)return;state.draggingWeight=false;sceneSvg.releasePointerCapture?.(e.pointerId);draw()});
    sceneSvg.addEventListener('pointercancel',()=>{state.draggingWeight=false});
    [['studyInput','study','studyReadout',''],['sleepInput','sleep','sleepReadout',''],['attendanceInput','attendance','attendanceReadout','%']].forEach(([id,key,out,suffix])=>{$('#'+id).addEventListener('input',e=>{state[key]=Number(e.target.value);$('#'+out).textContent=e.target.value+suffix;toyCalc();draw()})});
    $$('.quiz-card').forEach(card=>{const answer=card.dataset.answer;card.querySelectorAll('.quiz-option').forEach(btn=>btn.addEventListener('click',()=>{card.querySelectorAll('.quiz-option').forEach(b=>{b.disabled=true;b.classList.toggle('correct',b.dataset.choice===answer);if(b===btn&&b.dataset.choice!==answer)b.classList.add('incorrect')});const fb=card.querySelector('.quiz-feedback');fb.style.display='block';fb.style.color=btn.dataset.choice===answer?C.green:C.red}))});

    const requested=new URLSearchParams(location.search).get('stage');if(requested){const n=Math.max(1,Math.min(19,Number(requested)||1));setTimeout(()=>document.getElementById(`stage-${n}`).scrollIntoView({block:'start'}),80)}
    updateThresholdReadout();toyCalc();resize();activate(1);if(!reducedMotion)heroId=requestAnimationFrame(drawHero);
  })();
  </script>
</body>
</html>
