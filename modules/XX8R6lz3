    function cStage6(t){cWorld(t,K.violet,()=>{cHeader('06','NON-LINEARITY → BENDS','A straight stack stays straight. ReLU gives the network a gate that can carve a piecewise boundary.',K.violet);const panels=[{x:54,label:'LINEAR ONLY',sub:'weighted sums stay flat',accent:K.muted,bend:false},{x:526,label:'RELU GATED',sub:'positive evidence passes',accent:state.reluEnabled?K.violet:K.muted,bend:true}];panels.forEach((p,pi)=>{cGlass(p.x,150,420,334,p.accent,.08);cMono(p.label,p.x+24,184,11,p.accent,'left',850);cText(p.sub,p.x+24,210,13,K.muted);const gx=p.x+44,gy=250,gw=332,gh=178;for(let i=1;i<5;i++)cLine(gx+gw*i/5,gy,gx+gw*i/5,gy+gh,'rgba(148,163,184,.10)',1);for(let i=1;i<4;i++)cLine(gx,gy+gh*i/4,gx+gw,gy+gh*i/4,'rgba(148,163,184,.10)',1);cLine(gx,gy+gh,gx+gw,gy+gh,'rgba(148,163,184,.32)',1);cLine(gx,gy,gx,gy+gh,'rgba(148,163,184,.32)',1);if(!p.bend)cLine(gx+12,gy+gh*.78,gx+gw-16,gy+gh*.18,p.accent,3);else{const pts=[{x:gx+12,y:gy+gh*.78},{x:gx+gw*.28,y:gy+gh*.62},{x:gx+gw*.55,y:gy+gh*.58},{x:gx+gw*.78,y:gy+gh*.40},{x:gx+gw-16,y:gy+gh*.18}];cSmoothCurve(pts,p.accent,4,12);pts.slice(1,4).forEach(q=>cGlow(q.x,q.y,4,p.accent,.9))}cMono(p.bend?'piecewise boundary':'one linear boundary',p.x+210,458,12,p.accent,'center',750)});cPill('ReLU: positive passes',70,538,190,K.green);cPill('negative → 0',278,538,150,K.amber);cPill(state.task==='binary'?'binary · sigmoid':state.task==='multiclass'?'multi-class · softmax':'regression · linear',678,538,248,state.task==='regression'?K.green:K.indigo);cFooter(state.reluEnabled?'gate on · boundary can bend':'gate off · boundary stays linear','output activation matches the task')})}

