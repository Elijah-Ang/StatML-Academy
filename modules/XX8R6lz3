    function cStage10(t){cWorld(t,K.green,()=>{cHeader('10','OPTIMIZER → LOCAL STEPS','The learning rate controls the stride through a curved loss landscape. Drag the amber point.',K.green);const x=84,y=136,w=832,h=430;cGlass(x,y,w,h,K.green,.07);cMono('LOSS LANDSCAPE · ONE WEIGHT',x+26,y+32,11,K.green,'left',850);cPill(state.learningMode.toUpperCase()+' η',x+w-154,y+18,126,state.learningMode==='large'?K.red:K.indigo);const gx=x+68,gy=y+84,gw=w-118,gh=h-142,min=-.3,max=1.3,loss=v=>.10+2*Math.pow(v-.50,2),grad=v=>4*(v-.50),toPoint=v=>({x:gx+gw*(v-min)/(max-min),y:gy+gh-Math.min(1.45,loss(v))*gh/1.45});const pts=[];for(let i=0;i<=110;i++){const v=min+(max-min)*i/110;pts.push(toPoint(v))}cSmoothCurve(pts,K.indigo,4,14);cLine(gx,gy+gh,gx+gw,gy+gh,'rgba(148,163,184,.34)',1);cLine(gx,gy,gx,gy+gh,'rgba(148,163,184,.34)',1);cMono('weight w',gx+gw/2,gy+gh+32,11,K.muted,'center');cMono('loss L(w)',gx-26,gy+gh/2,11,K.muted,'center');const current=Math.max(0,Math.min(1,state.weight)),gradient=grad(current),next=current-state.learningRate*gradient,a=toPoint(current),b=toPoint(Math.max(min,Math.min(max,next))),m=toPoint(.5);cGlow(m.x,m.y,6,K.green);cMono('minimum',m.x,m.y-22,11,K.green,'center',800);cLine(a.x-98,a.y-gradient*28,a.x+98,a.y+gradient*28,K.amber,2,[6,6]);cGlow(a.x,a.y,10,K.amber);cMono('wₜ '+current.toFixed(2),a.x,a.y-28,12,K.amber,'center',800);cArrow(a.x,a.y,b.x,b.y,state.learningMode==='large'?K.red:K.green,3);cGlow(b.x,b.y,7,state.learningMode==='large'?K.red:K.green);cMono('wₜ₊₁ '+next.toFixed(2),b.x,b.y+24,12,state.learningMode==='large'?K.red:K.green,'center',800);const trajectory=[current],updates=state.learningMode==='large'?4:8;for(let i=0;i<updates;i++)trajectory.push(trajectory[trajectory.length-1]-state.learningRate*grad(trajectory[trajectory.length-1]));const visible=state.optimPaused?trajectory.length:Math.min(trajectory.length,1+Math.floor(Math.max(0,t-startTime)/520));for(let i=1;i<visible;i++){const p=toPoint(trajectory[i]),q=toPoint(trajectory[i-1]);if(p.x<gx-20||p.x>gx+gw+20)break;cArrow(q.x,q.y,p.x,p.y,state.learningMode==='large'?K.red:K.green,1.6);cGlow(p.x,p.y,4,state.learningMode==='large'?K.red:K.green)}cMono(state.learningMode==='tiny'?'tiny steps · steady but slow':state.learningMode==='large'?'too large · overshoot and bounce':'medium steps · efficient descent',500,606,13,state.learningMode==='large'?K.red:K.green,'center',800);const sc=Math.min(cw/1000,ch/700),ox=(cw-1000*sc)/2;state.curveGeom={ax:ox+gx*sc,aw:gw*sc,min:min,max:max};});}

